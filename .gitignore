macos/.symlinks/
macos/Flutter/ephemeral/
macos/Runner.xcworkspace/xcuserdata/
macos/Runner.xcodeproj/xcuserdata/
macos/Runner.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate

# Linux/Windows generated files
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Firebase / secrets
# Firebase client config is not a password, but ignore it for public repos unless
# you intentionally want Firebase project identifiers in Git.
