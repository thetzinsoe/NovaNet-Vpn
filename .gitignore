ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc.local

# Environment files and local credentials
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.mobileprovision
*.provisionprofile
service-account*.json
credentials*.json

